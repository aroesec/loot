# ---------------------------------------------------------------------------
# Database — required
# ---------------------------------------------------------------------------
# Any Postgres 14+. Neon, Supabase, RDS, or the one in docker-compose.yml.
DATABASE_URL="postgresql://user:password@host:5432/loot?sslmode=require"


# ---------------------------------------------------------------------------
# Session — required
# ---------------------------------------------------------------------------
# Signs the session cookie. At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Bump to invalidate every existing session — after a leaked password, or a
# lost laptop. Changing the password alone does not log other devices out.
SESSION_VERSION="1"


# ---------------------------------------------------------------------------
# Authentication — at least one method required; the app refuses to start
# without one. Pick whichever fits how you run it.
# ---------------------------------------------------------------------------

# --- Method 1: password (simplest) ---
# Generate with:  pnpm auth:hash 'your password here'
# The deployment then holds a scrypt digest rather than the password, so an
# environment dump does not hand over the login.
APP_PASSWORD_HASH=""

# Plaintext still works and is checked in constant time. Supported, not
# recommended — prefer APP_PASSWORD_HASH and leave this unset.
# APP_PASSWORD=""

# --- Method 2: OIDC (any standards-compliant provider) ---
# Google, Authentik, Keycloak, Zitadel, Okta, Auth0, Pocket ID.
# Redirect URI to register:  https://your-host/api/auth/oidc/callback
# OIDC_ISSUER="https://accounts.google.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_SCOPES="openid email profile"
#
# Comma-separated emails allowed to sign in. REQUIRED — an empty list denies
# everyone, deliberately. Without it, "sign in with Google" would mean anyone
# with a Google account can read your finances.
# OIDC_ALLOWED_USERS="you@example.com"

# --- Method 3: trusted header (behind an identity-aware proxy) ---
# For Authelia, Authentik, oauth2-proxy, Cloudflare Access, Tailscale.
#
# DANGER: a header is trivial to forge. Only enable this when the app is
# unreachable except through the proxy — a private network, a unix socket, or
# a firewall rule. If it is reachable directly, anyone can set the header.
# AUTH_PROXY_HEADER="x-forwarded-user"
# AUTH_PROXY_USERS="you@example.com"


# ---------------------------------------------------------------------------
# AI — optional
# ---------------------------------------------------------------------------
# Without a key: rules still categorize, anything unmatched goes to the review
# queue for you to answer, and CSV import is unaffected. What you lose is
# model-assisted categorization, insight write-ups, and PDF/image statements.
#
# Anthropic (default; the only provider here that reads PDFs)
AI_PROVIDER="anthropic"
AI_API_KEY=""
AI_MODEL="claude-opus-5"

# Anything speaking /v1/chat/completions — OpenAI, OpenRouter, Groq, Together,
# or a local runtime like Ollama, LM Studio or vLLM. Set AI_BASE_URL and the
# provider is inferred.
#
#   AI_PROVIDER="openai"
#   AI_API_KEY="ollama"                      # local runtimes often ignore this
#   AI_BASE_URL="http://localhost:11434/v1"
#   AI_MODEL="llama3.1:8b"


# ---------------------------------------------------------------------------
# Bank syncing via Plaid — optional
# ---------------------------------------------------------------------------
# Skip all of this and upload statements instead; it is a complete way to run
# the app, not a fallback. See docs/plaid.md before enabling.
#
# All three are required together — credentials without the encryption key
# would mean storing bank access tokens in the clear.
#
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# PLAID_ENV="sandbox"

# Encrypts Plaid access tokens at rest (AES-256-GCM). Generate like
# SESSION_SECRET. Rotating it invalidates every bank connection.
# PLAID_TOKEN_KEY=""


# ---------------------------------------------------------------------------
# Scheduled sync — optional
# ---------------------------------------------------------------------------
# Shared secret protecting /api/cron/sync. On Vercel this is sent
# automatically; self-hosting, the compose file's cron service sends it.
#
# A daily sync is cheap: transactions/sync returns only what changed since the
# cursor, so a run moves kilobytes rather than re-downloading history — and
# Plaid bills Transactions per Item per month, not per call.
#
# Generate like SESSION_SECRET.
# CRON_SECRET=""

# How many reverse proxies sit between the internet and this app.
#
# Rate limits are keyed on the caller's address, which is only knowable from
# X-Forwarded-For — a header the caller can write. Entries are counted from the
# right, and this says how many of them a trusted proxy wrote.
#
#   unset       0, or 1 when running on Vercel
#   0           directly reachable; no forwarding header is believed
#   1           one nginx / Caddy / Traefik / Cloudflare in front
#
# Too high is the harmful direction: it trusts entries the caller supplied,
# which lets anyone evade a limit or push someone else's bucket into lockout.
# TRUST_PROXY_HOPS="1"


# ---------------------------------------------------------------------------
# Push notifications — optional
# ---------------------------------------------------------------------------
# Web Push: a browser standard, with no third-party service between this
# deployment and your devices. Generate a key pair once with:
#
#   pnpm push:keys
#
# Rotating them invalidates every existing subscription, so devices have to
# re-enable alerts. Generate once and keep them.
#
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"

# --- Text messages via Twilio ---
# All four required together. Unlike browser push, every message is billed,
# which is why the alert rules refuse to send anything routine.
#
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+15550000000"     # your Twilio number, E.164
# ALERT_PHONE="+15551234567"     # where alerts go, E.164

